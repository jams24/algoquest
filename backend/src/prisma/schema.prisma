generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum League {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  MASTER
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String   @unique
  passwordHash   String?
  authProvider   String   @default("email") // "email" or "google"
  googleId       String?  @unique
  avatarUrl      String?
  xp             Int      @default(0)
  level          Int      @default(1)
  hearts         Int      @default(5)
  heartsUpdatedAt DateTime @default(now())
  streak         Int      @default(0)
  bestStreak     Int      @default(0)
  lastActiveDate DateTime?
  streakFreezes  Int      @default(1)
  league         League   @default(BRONZE)
  weeklyXp       Int      @default(0)
  dailyGoal      Int      @default(3)
  preferredLang  String   @default("python")
  // Onboarding
  experienceLevel String? // beginner, dabbled, semi-technical
  buildGoals      String? // JSON array: ["websites","mobile","ai","saas","games"]
  // Subscription
  trialStartDate       DateTime? @default(now())
  subscriptionStatus   String    @default("trial") // trial, active, expired, free
  subscriptionExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  progress               UserProgress[]
  achievements           UserAchievement[]
  reviews                SpacedReview[]
  designLessonProgress   UserDesignLessonProgress[]
  designQuestionProgress UserDesignQuestionProgress[]
}

model Topic {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  color       String
  order       Int       @unique
  problems    Problem[]
}

model Problem {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  difficulty      Difficulty
  order           Int
  topicId         String
  topic           Topic      @relation(fields: [topicId], references: [id])
  story           String
  visualSteps     Json
  pattern         String
  patternExplanation String
  solutions       Json       // { python: { code, lineExplanations }, java: {...}, cpp: {...} }
  complexity      Json       // { time, space, simpleExplanation }
  memoryTrick     String
  quiz            Json       // array of quiz questions
  hints           Json       // array of hint strings
  commonMistakes  Json       // array of mistake strings
  createdAt       DateTime   @default(now())

  progress        UserProgress[]
  reviews         SpacedReview[]
  dailyChallenges DailyChallenge[]

  @@unique([topicId, order])
}

model UserProgress {
  id         String        @id @default(uuid())
  userId     String
  problemId  String
  status     ProblemStatus @default(LOCKED)
  score      Int           @default(0)
  bestScore  Int           @default(0)
  attempts   Int           @default(0)
  stage      Int           @default(0) // 0=not started, 1=learn, 2=understand, 3=practice, 4=master
  lastAttempt DateTime?
  completedAt DateTime?

  user       User    @relation(fields: [userId], references: [id])
  problem    Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}

model Achievement {
  id          String @id @default(uuid())
  name        String @unique
  description String
  icon        String
  criteria    Json   // { type: "problems_completed", count: 1 } etc.

  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model DailyChallenge {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])
}

model SpacedReview {
  id           String   @id @default(uuid())
  userId       String
  problemId    String
  nextReview   DateTime
  interval     Int      @default(1) // days
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)

  user         User    @relation(fields: [userId], references: [id])
  problem      Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}

// ─────────────────────────────────────────────
// SYSTEM DESIGN
// ─────────────────────────────────────────────

model DesignTrack {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String
  icon        String         // emoji
  color       String         // hex color
  order       Int            @unique
  level       String         // "beginner" | "intermediate" | "advanced"
  lessons     DesignLesson[]
}

model DesignLesson {
  id           String      @id @default(uuid())
  title        String
  slug         String      @unique
  trackId      String
  track        DesignTrack @relation(fields: [trackId], references: [id])
  order        Int

  // Stage 1 — Understand
  summary      String      // plain-English explanation
  analogy      String      // real-world analogy

  // Stage 2 — Visualize
  diagram      String      // ASCII diagram (full picture)
  diagramSteps Json        // [{ step, title, description, diagram }]

  // Stage 3 — Compare
  tradeoffs    Json        // [{ title, optionA, optionB, recommendation, reasoning }]
  whenToUse    Json        // [{ scenario, reason }]
  whenNotToUse Json        // [{ scenario, reason }]
  keyPoints    Json        // string[] — bullet takeaways

  // Stage 4 — Quiz (same format as Problem.quiz)
  quiz         Json

  createdAt    DateTime    @default(now())

  progress     UserDesignLessonProgress[]

  @@unique([trackId, order])
}

model DesignQuestion {
  id        String     @id @default(uuid())
  title     String
  slug      String     @unique
  category  String     // "storage"|"social"|"messaging"|"media"|"search"|"infrastructure"|"commerce"
  difficulty Difficulty
  order     Int

  // Stage 1 — Requirements
  overview            String  // what we're designing + why interviewers ask it
  functionalReqs      Json    // string[]
  nonFunctionalReqs   Json    // string[]
  clarifyingQuestions Json    // string[] — questions to ask the interviewer

  // Stage 2 — Estimation
  estimations         Json    // { qps, storage, bandwidth, memory, calculations: string[] }

  // Stage 3 — Architecture
  diagram             String  // ASCII high-level architecture diagram
  components          Json    // [{ name, type, description, whyChosen, alternatives[] }]

  // Stage 4 — Deep Dive
  bottlenecks         Json    // [{ problem, solution }]
  tradeoffs           Json    // [{ decision, chosen, alternative, reasoning }]
  realWorldExamples   Json    // string[]
  tips                Json    // string[] — what interviewers look for

  // Stage 5 — Quiz
  quiz                Json

  createdAt           DateTime @default(now())

  progress            UserDesignQuestionProgress[]
}

model UserDesignLessonProgress {
  id          String       @id @default(uuid())
  userId      String
  lessonId    String
  status      String       @default("AVAILABLE") // AVAILABLE | IN_PROGRESS | COMPLETED
  stage       Int          @default(0)
  score       Int          @default(0)
  completedAt DateTime?

  user        User         @relation(fields: [userId], references: [id])
  lesson      DesignLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model UserDesignQuestionProgress {
  id          String         @id @default(uuid())
  userId      String
  questionId  String
  status      String         @default("AVAILABLE")
  stage       Int            @default(0)
  score       Int            @default(0)
  completedAt DateTime?

  user        User           @relation(fields: [userId], references: [id])
  question    DesignQuestion @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}
